---
import '@/styles/orthopedics.css';
import '@/styles/orthopedics-human.css';
interface Props {autoMotion?:boolean;opening?:'current'|'smile'|'portrait';}
const {autoMotion=true,opening='current'}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<div class="or-visual or-human" data-or-scene data-or-variant="human" data-or-opening={opening} data-or-auto-motion={autoMotion?'true':undefined}>
  <figure class="or-scene-panel">
    <div class="or-human-stage">
      <div class="or-human-photo" data-or-human-frame><img data-or-object src={`${base}orthopedics-concepts/human-smile-v1.webp`} alt="Улыбающаяся женщина" width="1536" height="1024" fetchpriority="high" decoding="async" /></div>
      <p class="or-human-loading" data-or-loading role="status">Фотография загружается…</p>
      <div class="or-human-copy"><h2><span>Ближе</span><span>к человеку.</span></h2><p class="or-human-copy-note">Знакомство начинается<br />с улыбки.</p></div>
    </div>
    <figcaption>Демонстрационный портрет. Не пациент или сотрудник клиники.</figcaption>
  </figure>
  <div class="or-human-scroll-space" aria-hidden="true"></div>
</div>
<script>
  import {initOrthopedicsScene} from './orthopedics-motion';
  document.querySelectorAll<HTMLElement>('[data-or-variant="human"][data-or-auto-motion="true"]').forEach(root=>initOrthopedicsScene(root));
</script>
