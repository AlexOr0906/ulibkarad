---
// Neutral study cast in an oblique view, with a continuous horseshoe foundation.
const outline='M320 80 C285 202 345 294 470 326 Q600 367 730 326 C855 294 915 202 880 80 Q864 49 828 58 L795 65 C825 179 785 215 700 238 Q600 270 500 238 C415 215 375 179 405 65 L372 58 Q336 49 320 80Z';
---
<g data-oa-upper-arch>
  <defs>
    <linearGradient id="oa-cast-side" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#c2c7c1"/><stop offset=".6" stop-color="#a0aaa5"/><stop offset="1" stop-color="#667d83"/></linearGradient>
    <linearGradient id="oa-cast-top" x1="0" y1="0" x2=".2" y2="1"><stop stop-color="#efeee3"/><stop offset=".45" stop-color="#e4e5db"/><stop offset=".85" stop-color="#c6d0cb"/><stop offset="1" stop-color="#99b0b3"/></linearGradient>
    <linearGradient id="oa-cast-inner" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#60747b"/><stop offset="1" stop-color="#c4cfca"/></linearGradient>
  </defs>
  <path d={outline} fill="#101d24" opacity=".35" transform="translate(0 22)"/>
  <path d={outline} fill="url(#oa-cast-side)" transform="translate(0 15)"/>
  <path d={outline} fill="url(#oa-cast-top)" stroke="#eff4ec" stroke-opacity=".35" stroke-width="1"/>
  <path d="M405 65 C375 179 415 215 500 238 Q600 270 700 238 C785 215 825 179 795 65 L790 86 C809 181 770 213 696 232 Q600 260 504 232 C430 213 391 181 410 86Z" fill="url(#oa-cast-inner)"/>
  <path d="M337 88 C308 200 366 278 479 307 Q600 345 721 307 C834 278 892 200 863 88" fill="none" stroke="#fbfff6" stroke-opacity=".35" stroke-width="2"/>
</g>
