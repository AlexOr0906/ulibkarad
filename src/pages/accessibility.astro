---
import InternalPageLayout from '@/layouts/InternalPageLayout.astro';
import ReadingControls from '@/components/site-functions/ReadingControls.astro';
import {siteNavigation} from '@/data/site-preview-navigation';
const base=import.meta.env.BASE_URL,nav=siteNavigation(base);
---
<InternalPageLayout title="Версия для слабовидящих" description="Настройте размер текста, цвета и изображения на всех страницах OrthoFamily." homeHref={nav.home} contactHref={nav.contactHref} navigation={nav.navigation} footerNavigation={nav.footerNavigation} transitionHrefs={nav.transitionHrefs}>
 <div class="sf-shell"><nav class="sf-crumbs" aria-label="Хлебные крошки"><a href={base}>Главная</a> / Версия для слабовидящих</nav><h1>Читать так,<br />как удобно вам.</h1><p class="sf-lead">Включите версию для слабовидящих или выберите подходящий размер текста и цвет страницы. Настройки действуют на всём сайте. Открыть их можно в любой момент кнопкой в шапке.</p>
 <ReadingControls />
 <noscript><p>Для изменения и сохранения настроек нужен JavaScript. Вы можете увеличить страницу средствами браузера. <a href={`${base}sitemap/`}>Карта сайта</a> доступна без JavaScript.</p></noscript>
 </div>
</InternalPageLayout>
