---
import '@/styles/orthodontics-arc.css';
const base=import.meta.env.BASE_URL;
interface Props {contactHref:string;}
const {contactHref}=Astro.props;
const teeth=[{x:433.51,y:211.41,r:30,s:0.34},{x:456.29,y:229.64,r:25,s:0.36},{x:479.08,y:250.14,r:20,s:0.38},{x:501.86,y:268.37,r:15,s:0.4},{x:524.65,y:279.77,r:9,s:0.43},{x:558.83,y:283.41,r:3,s:0.46},{x:599.85,y:288.88,r:0,s:0.5},{x:643.14,y:288.88,r:0,s:0.5},{x:686.43,y:284.32,r:-3,s:0.46},{x:725.17,y:279.77,r:-9,s:0.43},{x:757.07,y:268.37,r:-15,s:0.4},{x:779.86,y:247.86,r:-20,s:0.38},{x:802.65,y:229.64,r:-25,s:0.36},{x:816.32,y:209.13,r:-30,s:0.34}];
const points=[{x:-180,y:130},{x:140,y:110},...teeth,{x:1040,y:160},{x:1120,y:320},{x:1020,y:600}];
const wire=points.reduce((path,p,i)=>{if(!i)return `M${p.x} ${p.y}`;const a=points[i-1],before=points[Math.max(0,i-2)],after=points[Math.min(points.length-1,i+1)];return path+` C${a.x+(p.x-before.x)/6} ${a.y+(p.y-before.y)/6} ${p.x-(after.x-a.x)/6} ${p.y-(after.y-a.y)/6} ${p.x} ${p.y}`;},'');
---
<div class="oa" data-oa>
  <section class="oa-scene" id="arc-start" aria-labelledby="arc-title" data-oa-scene>
    <div class="oa-stage" data-oa-stage>
      <header class="oa-heading"><p class="oa-eyebrow">Ортодонтия / исследование движения</p><h1 id="arc-title">Всё связано.</h1><p class="oa-subtitle">Одна линия.<br />Целая система.</p></header>
      <div class="oa-art" role="img" aria-label="Демонстрационная AI-модель нижней челюсти с видимым телом челюсти и брекетной системой. Не медицинская схема.">
        <svg viewBox="0 0 1200 520" aria-hidden="true" class="oa-svg">
          <defs>
            <radialGradient id="oa-enamel" cx=".36" cy=".27" r=".8" gradientTransform="translate(0 -.12) scale(1 1.25)"><stop stop-color="#fffef5"/><stop offset=".34" stop-color="#eeeee3"/><stop offset=".7" stop-color="#c9d0cd"/><stop offset=".9" stop-color="#899a9e"/><stop offset="1" stop-color="#576b74"/></radialGradient>
            <linearGradient id="oa-enamel-edge" x1="0" y1="0" x2="0" y2="1"><stop offset=".62" stop-color="#d6e6e8" stop-opacity="0"/><stop offset=".93" stop-color="#e5f3f4" stop-opacity=".2"/><stop offset="1" stop-color="#9eb9c2" stop-opacity=".6"/></linearGradient>
            <radialGradient id="oa-enamel-light" cx=".3" cy=".2" r=".7"><stop stop-color="#fff" stop-opacity=".7"/><stop offset=".45" stop-color="#fff" stop-opacity=".12"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
            <linearGradient id="oa-steel-face" x1="0" y1="0" x2=".28" y2="1"><stop stop-color="#d1dadf"/><stop offset=".12" stop-color="#f8fbfc"/><stop offset=".2" stop-color="#a9b5bd"/><stop offset=".55" stop-color="#6b7b86"/><stop offset=".79" stop-color="#bdc9cf"/><stop offset="1" stop-color="#e7eef1"/></linearGradient>
            <linearGradient id="oa-steel-side" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#172631"/><stop offset=".28" stop-color="#70838f"/><stop offset=".6" stop-color="#b9c8d0"/><stop offset="1" stop-color="#3b4b56"/></linearGradient>
            <linearGradient id="oa-steel-bevel" x1="0" y1="0" x2=".1" y2="1"><stop stop-color="#f6fcff"/><stop offset=".35" stop-color="#dae6ed"/><stop offset=".47" stop-color="#738994"/><stop offset="1" stop-color="#283d49"/></linearGradient>
            <pattern id="oa-machining" width="1.8" height="1.8" patternUnits="userSpaceOnUse"><path d="M0 .3H1.8" stroke="#fff" stroke-opacity=".09" stroke-width=".14"/><path d="M0 1.1H1.8" stroke="#0d1b24" stroke-opacity=".1" stroke-width=".12"/></pattern>
            <linearGradient id="oa-metal" x1="0" y1="0" x2=".65" y2="1"><stop stop-color="#f6ffff"/><stop offset=".14" stop-color="#8c9ba4"/><stop offset=".33" stop-color="#f1f7fa"/><stop offset=".44" stop-color="#c6d2d8"/><stop offset=".51" stop-color="#4d606e"/><stop offset=".73" stop-color="#99abb6"/><stop offset=".87" stop-color="#f5fafb"/><stop offset="1" stop-color="#51636e"/></linearGradient>
            <linearGradient id="oa-edge" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#fff"/><stop offset=".18" stop-color="#a4b9c6"/><stop offset=".48" stop-color="#304451"/><stop offset=".7" stop-color="#91a8b6"/><stop offset="1" stop-color="#d8e4ea"/></linearGradient>
            <linearGradient id="oa-wire" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#6e8493"/><stop offset=".42" stop-color="#eefaff"/><stop offset=".58" stop-color="#b3c4cf"/><stop offset="1" stop-color="#607582"/></linearGradient>
            <radialGradient id="oa-pool"><stop stop-color="#a1b9c6" stop-opacity=".16"/><stop offset="1" stop-color="#a1b9c6" stop-opacity="0"/></radialGradient>
            <filter id="oa-shadow" x="-70%" y="-70%" width="240%" height="260%"><feDropShadow dx="0" dy="3" stdDeviation="1.7" flood-color="#071019" flood-opacity=".6"/></filter>
            <g id="oa-bracket">
              <path d="M-31 -28Q0 -36 31 -28L33 25Q0 35 -33 25Z" fill="url(#oa-steel-side)" stroke="#99aab5" stroke-width=".65"/>
              <path d="M-29 -27Q0 -33 29 -27L30 23Q0 31 -30 23Z" fill="url(#oa-steel-face)"/>
              <path d="M-28 -26Q0 -32 28 -26L29 22Q0 30 -29 22Z" fill="url(#oa-machining)"/>
              <path d="M-24 -22H-5V23H-24Z M5 -22H24V23H5Z" fill="#344652"/>
              <path d="M-20 -25H-9V26H-20Z M9 -25H20V26H9Z" fill="url(#oa-steel-side)"/>
              {/* Four separate tie wings with undercuts, bevels and a recessed transverse slot. */}
              {[-1,1].map(x=>[-1,1].map(y=><g transform={`scale(${x} ${y})`}>
                <path d="M7 8H27L29 25L24 31H10L6 26Z" fill="#253844"/>
                <path d="M7 6L11 3H25L29 7V24L24 28H10L7 24Z" fill="url(#oa-steel-side)" stroke="#8598a4" stroke-width=".35"/>
                <path d="M9 7L12 4H24L27 7V22L24 25H12L9 22Z" fill="url(#oa-steel-face)"/>
                <path d="M9 7L12 4H24L27 7L24 9H12Z" fill="url(#oa-steel-bevel)"/>
                <path d="M9 7V22L12 25V9Z" fill="#d9e4ea" opacity=".75"/>
                <path d="M12 9H24V23H12Z" fill="url(#oa-machining)"/>
                <path d="M12 25H24L27 22" fill="none" stroke="#1c303d" stroke-width=".8"/>
                <path d="M10 7L12 5H24" fill="none" stroke="#fff" stroke-width=".55" opacity=".9"/>
              </g>))}
              <path d="M-30 -3.3H30V3.3H-30Z" fill="#13232e"/>
              <path d="M-29 -3.6H29" stroke="#f5fbff" stroke-width=".7"/>
              <path d="M-29 4H29" stroke="#607782" stroke-width=".7"/>
              <path d="M-4 -24V-7M4 8V24" stroke="#1e323f" stroke-width=".8"/>
              <circle cx="-3" cy="19" r="1" fill="#334b59"/><circle cx="-3.2" cy="18.8" r=".4" fill="#b0c1cb"/>
            </g>
          </defs>
          <ellipse cx="600" cy="290" rx="550" ry="220" fill="url(#oa-pool)"/>
          <g data-oa-camera>
            <g data-oa-teeth><image href={`${base}orthodontics-concept/mandible-study-v1.png`} x="274" y="20" width="700" height="466.667" preserveAspectRatio="xMidYMid meet" /></g>
            {teeth.map((t,i)=><g transform={`translate(${t.x} ${t.y}) rotate(${t.r}) scale(${t.s})`}><g data-oa-bracket data-index={i} filter="url(#oa-shadow)"><use href="#oa-bracket"/></g></g>)}
            <path d={wire} fill="none" stroke="#101e28" stroke-width="4" opacity=".45" transform="translate(0 1.8)" data-oa-wire-shadow/>
            <path d={wire} fill="none" stroke="url(#oa-wire)" stroke-width="2.6" stroke-linecap="round" data-oa-wire/>
            <path d={wire} fill="none" stroke="#fff" stroke-opacity=".75" stroke-width=".55" transform="translate(0 -.65)" data-oa-wire-highlight/>
            <path d="M1020 600V5000" fill="none" stroke="#c9dbe5" stroke-width="2" data-oa-tail/>
          </g>
        </svg>
      </div>
      <div class="oa-stage-bottom"><div><span class="oa-phase" data-oa-phase>Целая система</span><p>AI-модель челюсти. Не медицинская схема.</p></div><a href="#arc-story" class="oa-skip">Дальше по линии <span aria-hidden="true">↓</span></a></div>
      <div class="oa-progress" aria-hidden="true"><i data-oa-progress></i></div>
    </div>
  </section>
  <section class="oa-story" id="arc-story" aria-labelledby="arc-story-title" data-oa-story>
    <svg class="oa-thread" viewBox="0 0 1200 1000" preserveAspectRatio="none" aria-hidden="true"><path d="M1020 -50 C1020 100 1000 180 820 200 S170 190 170 420 S1000 540 1000 720 S650 810 650 1050" fill="none" stroke="#b9c7ce" stroke-opacity=".16" stroke-width="2"/><path data-oa-thread d="M1020 -50 C1020 100 1000 180 820 200 S170 190 170 420 S1000 540 1000 720 S650 810 650 1050" fill="none" stroke="#c9dbe5" stroke-width="2" pathLength="1"/></svg>
    <div class="oa-story-first"><p class="oa-eyebrow">Концепция «Дуга»</p><h2 id="arc-story-title">Деталь становится<br />целым.</h2><p>Линия соединяет элементы системы.<br />И продолжает путь по странице.</p></div>
    <div class="oa-story-second"><h2>Продолжим<br />знакомство?</h2><p>Здесь появится согласованная информация об ортодонтии. Пока проверяем образ, движение и ощущение от страницы.</p><div class="oa-actions"><a href={contactHref}>Связаться с клиникой <span aria-hidden="true">↗</span></a><a href="#arc-start">Посмотреть ещё раз <span aria-hidden="true">↑</span></a></div></div>
    <p class="oa-note">Демонстрационная AI-модель создана для обсуждения анимации. Конструкция условная; не иллюстрирует установку системы или результат лечения.</p>
  </section>
</div>
<script>
 import {initArc} from './arc-motion';
 document.querySelectorAll<HTMLElement>('[data-oa]').forEach(initArc);
</script>
