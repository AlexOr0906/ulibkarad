---
interface Props { class?: string; label?: string; animated?: boolean; }
const { class: className = '', label, animated = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<span class:list={['metal-emblem', className]} data-metal-emblem={animated ? '' : undefined} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} style={`--emblem-mask: url("${base}brand/logo-chrome.svg")`}>
  <img class="metal-emblem-face" src={`${base}brand/logo-chrome.svg`} width="921" height="960" alt="" />
  {animated && <span class="metal-emblem-sheen" aria-hidden="true"></span>}
</span>

<script>
  const emblems = [...document.querySelectorAll<HTMLElement>('[data-metal-emblem]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const visible = new Set<Element>();
  function sync() {
    emblems.forEach(emblem => { emblem.dataset.metalActive = String(visible.has(emblem) && !document.hidden && !reduced.matches); });
  }
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => { if (entry.isIntersecting) visible.add(entry.target); else visible.delete(entry.target); });
    sync();
  }, {threshold: .05});
  emblems.forEach(emblem => observer.observe(emblem));
  document.addEventListener('visibilitychange', sync);
  reduced.addEventListener('change', sync);
</script>
