---
import ArrowIcon from '../ArrowIcon.astro';
import { navigation as defaultNavigation } from '../../data/site';
import { informationDocuments } from '../../data/contacts-footer';
import '../../styles/contacts-footer.css';
import '../../styles/orthofamily-wordmark.css';
interface Props { homeHref?: string; topHref?: string; navigation?: { label: string; href: string }[]; activeHref?: string; }
const base = import.meta.env.BASE_URL;
const { homeHref = base, topHref = '#top', navigation = defaultNavigation, activeHref } = Astro.props;
---
<footer class="cf-footer" aria-label="OrthoFamily: навигация и информация">
  <div class="cf-wrap">
    <div class="cf-footer-top">
      <p>Стоматология для взрослых и детей.<br />Магнитогорск.</p>
      <a class="cf-back-top" href={topHref}>В начало страницы <ArrowIcon /></a>
    </div>
    <a class="cf-brand" href={homeHref} aria-current={homeHref === activeHref ? 'page' : undefined} aria-label="OrthoFamily: главная страница">
      <img src={`${base}brand/logo-chrome.svg`} alt="" width="921" height="960" loading="lazy" />
      <span class="of-brand-wordmark">OrthoFamily<small class="of-brand-descriptor">Стоматология для всей семьи</small></span>
    </a>
    <div class="cf-footer-grid">
      <nav aria-label="Навигация в футере"><h2>Знакомство с клиникой</h2><ul>{navigation.map(item => <li><a href={`${homeHref}${item.href}`} aria-current={`${homeHref}${item.href}` === activeHref ? 'page' : undefined}>{item.label}<ArrowIcon /></a></li>)}</ul></nav>
      <div class="cf-documents"><h2>Информация для пациентов</h2><ul>{informationDocuments.map(document => <li>{document.href ? <a href={`${base}${document.href.replace(/^\/+/, '')}`}>{document.title}<ArrowIcon /></a> : <span>{document.title}<small>Готовится</small></span>}</li>)}</ul></div>
      <div class="cf-legal"><h2>О клинике</h2><details><summary>Реквизиты клиники <span aria-hidden="true">+</span></summary><dl><div><dt>Юридическое лицо</dt><dd>Сведения будут добавлены</dd></div><div><dt>ИНН и ОГРН</dt><dd>Сведения будут добавлены</dd></div><div><dt>Лицензия</dt><dd>Реквизиты и документ ожидаются</dd></div></dl></details><p>Юридическая информация и документы будут размещены после подтверждения клиникой.</p></div>
    </div>
    <div class="cf-footer-bottom"><p>© {new Date().getFullYear()} OrthoFamily</p><p>Демонстрационный макет. Данные уточняются.</p></div>
  </div>
</footer>

<script>
  import { initClosingMotion } from './closing-motion';
  initClosingMotion();
</script>
