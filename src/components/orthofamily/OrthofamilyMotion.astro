<script>
  const introElement = document.querySelector<HTMLElement>('[data-of-intro]');
  if (introElement) {
    const intro = introElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const phone = matchMedia('(max-width: 767px)');
    let frame = 0, span = 1, lastProgress = -1, shown = 0, lastTime = performance.now();
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    function update(now = performance.now()) {
      frame = 0;
      // Touch scene follows the document. No competing scroll/resize timeline.
      if (phone.matches) return;
      const target = clamp(-intro.getBoundingClientRect().top / span);
      const dt = Math.min(50, Math.max(1, now - lastTime)); lastTime = now;
      // Damped native-scroll response, with a snap for deliberate big jumps.
      if (reduced.matches || Math.abs(target - shown) > .45) shown = target;
      else shown += (target - shown) * (1 - Math.exp(-dt / 75));
      if (Math.abs(target - shown) < .0001) shown = target;
      const p = shown;
      if (Math.abs(p - lastProgress) > .00001) {
        lastProgress = p;
        const eased = p * p * (3 - 2 * p);
        const mobile = phone.matches;
        intro.style.setProperty('--of-object-scale', String(reduced.matches ? 1 : 1 + (mobile ? .018 : .08) * Math.sin(Math.PI * p)));
        intro.style.setProperty('--of-object-y', `${reduced.matches ? 0 : (mobile ? -6 : -28) * eased}px`);
        intro.style.setProperty('--of-object-x', `${reduced.matches || mobile ? 0 : 22 * Math.sin(Math.PI * p)}px`);
        intro.style.setProperty('--of-object-turn', `${reduced.matches ? 0 : (mobile ? -2 + 4 * eased : -5 + 13 * eased)}deg`);
        intro.style.setProperty('--of-paper-y', `${reduced.matches ? 0 : (mobile ? -24 : -70) * eased}px`);
        intro.style.setProperty('--of-paper-x', `${reduced.matches || mobile ? 0 : -4 * eased}vw`);
        intro.style.setProperty('--of-orbit-y', `${reduced.matches ? 0 : (mobile ? 12 : 42) * eased}px`);
        intro.style.setProperty('--of-orbit-scale', String(reduced.matches ? 1 : 1 - (mobile ? .06 : .14) * eased));
        intro.style.setProperty('--of-reflection', `${-70 + 240 * eased}%`);
        intro.dataset.ofProgress = p.toFixed(4);
        intro.dataset.ofTarget = target.toFixed(4);
      }
      if (shown !== target) frame = requestAnimationFrame(update);
    }
    function queue() { if (!frame) frame = requestAnimationFrame(update); }
    function measure() {
      intro.dataset.ofMotion = reduced.matches ? 'reduced' : phone.matches ? 'phone' : 'full';
      // svh geometry remains stable when a phone browser's address bar changes.
      const viewport = intro.querySelector<HTMLElement>(phone.matches ? '.of-hero' : '.of-opening')!.offsetHeight;
      span = Math.max(1, intro.offsetHeight - viewport);
      intro.dataset.ofSpan = String(span);
      if (lastProgress < 0 || reduced.matches) shown = clamp(-intro.getBoundingClientRect().top / span);
      lastProgress = -1;
      queue();
    }
    addEventListener('scroll', queue, {passive: true});
    addEventListener('resize', measure, {passive: true});
    addEventListener('of-header-resize', measure);
    reduced.addEventListener('change', measure);
    document.fonts.ready.then(measure);
    measure();

    // Time-based phone choreography: scrolling never changes the object's pose.
    const object = intro.querySelector<HTMLElement>('[data-of-main-photo]')!;
    let objectVisible = false, phoneRevealPending = false;
    function revealPhoneObject(visible: boolean) {
      objectVisible = visible;
      if (phone.matches && !reduced.matches && visible && !intro.dataset.ofPhoneReveal && !phoneRevealPending) {
        phoneRevealPending = true;
        object.querySelector<HTMLImageElement>('img')!.decode().catch(() => {}).then(() => {
          phoneRevealPending = false;
          if (phone.matches && !reduced.matches && objectVisible) intro.dataset.ofPhoneReveal = 'entered';
        });
      }
      intro.style.setProperty('--of-phone-play', visible && !document.hidden ? 'running' : 'paused');
    }
    if ('IntersectionObserver' in window) {
      const objectObserver = new IntersectionObserver(entries => entries.forEach(entry => revealPhoneObject(entry.isIntersecting && entry.intersectionRatio >= .2)), {threshold:.2});
      objectObserver.observe(object);
    } else revealPhoneObject(true);
    document.addEventListener('visibilitychange', () => {
      const rect = object.getBoundingClientRect();
      revealPhoneObject(rect.bottom > 0 && rect.top < innerHeight);
    });

    const cards = [...document.querySelectorAll<HTMLDetailsElement>('[data-of-direction]')];
    const animations = new Map<HTMLDetailsElement, Animation>();
    const targets = new Map<HTMLDetailsElement, boolean>();
    function setOpen(card: HTMLDetailsElement, open: boolean) {
      const start = card.getBoundingClientRect().height;
      animations.get(card)?.cancel(); animations.delete(card);
      targets.set(card, open);
      const panel = card.querySelector<HTMLElement>('.of-direction-panel')!;
      if (reduced.matches) { card.open = open; panel.inert = false; return; }
      card.open = true; panel.inert = !open;
      const end = open ? card.getBoundingClientRect().height : card.querySelector('summary')!.getBoundingClientRect().height + 1;
      const animation = card.animate({height: [`${start}px`, `${end}px`]}, {duration: 330, easing: 'cubic-bezier(.22,1,.36,1)'});
      animations.set(card, animation);
      animation.onfinish = () => { card.open = open; panel.inert = false; animations.delete(card); };
    }
    cards.forEach(card => card.querySelector('summary')!.addEventListener('click', event => {
      event.preventDefault();
      const willOpen = !(targets.get(card) ?? card.open);
      if (willOpen) cards.filter(other => other !== card && other.open).forEach(other => setOpen(other, false));
      setOpen(card, willOpen);
    }));
    reduced.addEventListener('change', () => { if (reduced.matches) animations.forEach(animation => animation.finish()); });
    addEventListener('resize', () => animations.forEach(animation => animation.finish()), {passive: true});

    const dialog = document.querySelector<HTMLDialogElement>('#of-visit-dialog')!;
    const topic = dialog.querySelector<HTMLElement>('#of-dialog-topic')!;
    let trigger: HTMLElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-of-visit]').forEach(link => link.addEventListener('click', event => {
      event.preventDefault(); trigger = link;
      topic.hidden = !link.dataset.ofTopic; topic.textContent = link.dataset.ofTopic ? `Тема разговора: ${link.dataset.ofTopic}` : '';
      dialog.showModal(); document.body.classList.add('of-dialog-open');
    }));
    dialog.addEventListener('close', () => { document.body.classList.remove('of-dialog-open'); trigger?.focus({preventScroll: true}); });
    dialog.addEventListener('click', event => { const r = dialog.getBoundingClientRect(); if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) dialog.close(); });
    dialog.addEventListener('keydown', event => {
      if (event.key !== 'Tab') return;
      const controls = [...dialog.querySelectorAll<HTMLButtonElement>('button')];
      if (event.shiftKey && document.activeElement === controls[0]) { event.preventDefault(); controls.at(-1)?.focus(); }
      else if (!event.shiftKey && document.activeElement === controls.at(-1)) { event.preventDefault(); controls[0]?.focus(); }
    });
  }
</script>

