---
import '@/styles/global.css';
import '@/styles/clinic-motion.css';
import cyrillicFontUrl from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
const base = import.meta.env.BASE_URL;

interface Props {
  title: string;
  description: string;
  bracketVariant?: 'clinic' | 'background' | 'spacing';
}

const { title, description, bracketVariant } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#ebe9eb" />
    <link rel="icon" type="image/svg+xml" href={`${base}brand/logo-graphite.svg`} />
    <link rel="preload" href={cyrillicFontUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body data-bracket-variant={bracketVariant}>
    <slot />
    <script is:inline src={`${base}vendor/scrollcraft.js`}></script>
    <script is:inline>window.ScrollCraft.mount(document.body);</script>
  </body>
</html>
