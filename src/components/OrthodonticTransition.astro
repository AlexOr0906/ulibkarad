---
const base = import.meta.env.BASE_URL;
---
<div class="ortho-transition" data-ortho-scene data-sc-act="flow" data-sc-verify-state="static-wire" data-sc-verify-hold="true" aria-hidden="true">
  <div class="ortho-canvas">
    <picture class="ortho-object ortho-wire" data-ortho-wire>
      <source srcset={`${base}orthodontics/wire-brackets-v1.webp`} type="image/webp" />
      <img src={`${base}orthodontics/wire-brackets-v1.png`} width="2073" height="758" alt="" decoding="async" draggable="false" />
    </picture>
    <picture class="ortho-object ortho-aligner" data-ortho-aligner>
      <source srcset={`${base}orthodontics/clear-aligner-v1.webp`} type="image/webp" />
      <img src={`${base}orthodontics/clear-aligner-v1.png`} width="1536" height="1024" alt="" loading="lazy" decoding="async" draggable="false" />
    </picture>
  </div>
</div>

<script>
  const scene = document.querySelector<HTMLElement>('[data-ortho-scene]');
  const wire = scene?.querySelector<HTMLElement>('[data-ortho-wire]');
  const aligner = scene?.querySelector<HTMLElement>('[data-ortho-aligner]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const phone = window.matchMedia('(max-width: 767px)');
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const smooth = (a: number, b: number, value: number) => {
    const t = clamp((value - a) / (b - a));
    return t * t * (3 - 2 * t);
  };
  let target = 0;
  let current = 0;
  let frame = 0;
  let dirty = true;
  let inView = false;
  let previousTime = 0;

  function paint(progress: number) {
    if (!scene || !wire || !aligner) return;
    if (reduced.matches) {
      wire.style.transform = 'translate3d(-50%, -50%, 0)';
      wire.style.opacity = '1';
      aligner.style.opacity = '0';
      scene.dataset.scVerifyState = 'static-wire';
      scene.dataset.scVerifyHold = 'true';
      return;
    }
    const compact = phone.matches;
    const arrival = smooth(.015, .17, progress);
    const wireExit = smooth(.43, .61, progress);
    const alignerArrival = smooth(.56, .73, progress);
    const departure = smooth(.89, 1, progress);
    const wireOpacity = arrival * (1 - wireExit);
    const alignerOpacity = alignerArrival * (1 - departure);
    const wireX = (compact ? 45 : 190) * (1 - arrival) - (compact ? 42 : 210) * wireExit - progress * (compact ? 65 : 220);
    const wireY = (1 - arrival) * (compact ? 10 : 22) - wireExit * (compact ? 5 : 13);
    const wireAngle = (compact ? 1.3 : 3.2) - progress * (compact ? 2.2 : 5.4);
    const alignerX = (compact ? 30 : 120) * (1 - alignerArrival) - departure * (compact ? 14 : 45);
    const alignerY = (1 - alignerArrival) * 24 - departure * 12;
    const alignerAngle = -8 + alignerArrival * 10 + departure * 3;
    wire.style.opacity = wireOpacity.toFixed(4);
    wire.style.transform = `translate3d(calc(-50% + ${wireX.toFixed(2)}px), calc(-50% + ${wireY.toFixed(2)}px), 0) rotate(${wireAngle.toFixed(2)}deg)`;
    aligner.style.opacity = alignerOpacity.toFixed(4);
    aligner.style.transform = `translate3d(calc(-50% + ${alignerX.toFixed(2)}px), calc(-50% + ${alignerY.toFixed(2)}px), 0) rotate(${alignerAngle.toFixed(2)}deg)`;
    scene.dataset.scVerifyState = `wire:${Math.round(wireOpacity * 100)}|polymer:${Math.round(alignerOpacity * 100)}|p:${Math.round(progress * 100)}`;
    scene.dataset.scVerifyHold = String(progress === 0 || progress === 1);
    scene.dataset.orthoProgress = progress.toFixed(4);
  }

  function measure() {
    if (!scene) return;
    const rect = scene.getBoundingClientRect();
    target = clamp((window.innerHeight * .8 - rect.top) / (window.innerHeight * .65 + rect.height * .35));
    dirty = false;
  }

  function tick(time: number) {
    frame = 0;
    if (dirty) measure();
    if (reduced.matches) { paint(.32); return; }
    const dt = previousTime ? Math.min(48, time - previousTime) : 16;
    previousTime = time;
    current += (target - current) * (1 - Math.exp(-dt / (phone.matches ? 48 : 65)));
    if (Math.abs(target - current) < .0004) current = target;
    paint(current);
    if (inView && current !== target && !document.hidden) frame = requestAnimationFrame(tick);
  }

  function requestMeasure() {
    dirty = true;
    if (!frame && !document.hidden && (inView || reduced.matches)) frame = requestAnimationFrame(tick);
  }

  if (scene) {
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) requestMeasure();
      else {
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        measure(); current = target; paint(current);
      }
    }, { rootMargin: '100px 0px' });
    observer.observe(scene);
    window.addEventListener('scroll', requestMeasure, { passive: true });
    window.addEventListener('resize', requestMeasure, { passive: true });
    reduced.addEventListener('change', requestMeasure);
    phone.addEventListener('change', requestMeasure);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && frame) { cancelAnimationFrame(frame); frame = 0; }
      else requestMeasure();
    });
    measure(); current = target; paint(current);
  }
</script>
