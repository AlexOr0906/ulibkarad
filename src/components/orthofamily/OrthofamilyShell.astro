---
import '@/styles/orthofamily.css';
import OrthofamilyMotion from './OrthofamilyMotion.astro';
import cyrillicFont from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
const base = import.meta.env.BASE_URL;
interface Props { withTeam?: boolean; }
const { withTeam = false } = Astro.props;
---
<!doctype html>
<html lang="ru" class:list={['of-document', {'of-complete': Astro.slots.has('header') }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content="OrtoFamily — концепция стоматологии для взрослых и детей в Магнитогорске. Демонстрация нового вступления сайта." />
    <meta name="theme-color" content="#eef1f3" />
    <link rel="icon" type="image/svg+xml" href={`${base}brand/logo-graphite.svg`} />
    <link rel="preload" href={cyrillicFont} as="font" type="font/woff2" crossorigin />
    <title>OrtoFamily — стоматология для взрослых и детей · Концепция</title>
    <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('of-motion');</script>
    {withTeam && <script is:inline>document.documentElement.classList.add('js');</script>}
  </head>
  <body class="of-page" data-bracket-variant={withTeam ? 'clinic' : undefined}>
    <a class="of-skip" href="#of-main">Перейти к содержимому</a>
    {Astro.slots.has('header') ? <slot name="header" /> : <header class="of-header">
      <div class="of-shell of-header-inner">
        <a class="of-brand" href="#of-top" aria-label="Ортофэмили — в начало">
          <img src={`${base}orthofamily/brand/emblem-silver-original.jpg`} alt="" width="1322" height="1190" />
          <span>Ортофэмили<small>Стоматология</small></span>
        </a>
        <nav class="of-nav" aria-label="Основная навигация">
          <a href="#of-about">Подход</a><a href="#of-directions">Направления</a>
          {withTeam && <a href="#doctors">Команда</a>}
        </nav>
        <a class="of-button of-header-visit" href="#of-visit" data-of-visit>Обсудить визит <span aria-hidden="true">↗</span></a>
      </div>
    </header>}
    <main id="of-main" tabindex="-1" data-of-root><slot /></main>
    {Astro.slots.has('closing') ? <slot name="closing" /> : <footer class="of-footer" id="of-visit">
      <div class="of-shell of-footer-inner">
        <div><p class="of-footer-name">OrtoFamily</p><p>Демо-концепция. Запись не производится.<br/>Контакты и материалы будут согласованы с клиникой.</p></div>
        <a href={withTeam ? `${base}orthofamily-preview/` : `${base}orthofamily-combined/`}>{withTeam ? 'Только вступление' : 'Вступление и команда'} <span aria-hidden="true">↗</span></a>
        <a href="#of-top">В начало <span aria-hidden="true">↑</span></a>
      </div>
    </footer>}
    <dialog class="of-dialog" id="of-visit-dialog" aria-labelledby="of-dialog-title" aria-describedby="of-dialog-description">
      <form method="dialog" class="of-dialog-top"><span>OrtoFamily</span><button type="submit" aria-label="Закрыть окно">×</button></form>
      <p class="of-eyebrow">Знакомство с клиникой</p>
      <h2 id="of-dialog-title">Обсудим ваш визит.</h2>
      <p class="of-dialog-topic" id="of-dialog-topic" hidden></p>
      <p id="of-dialog-description">Это демонстрация. Возможность записи появится после согласования контактов и способа связи с клиникой.</p>
      <form method="dialog"><button class="of-button" type="submit">Вернуться к просмотру <span aria-hidden="true">↗</span></button></form>
    </dialog>
    <OrthofamilyMotion />
  </body>
</html>
