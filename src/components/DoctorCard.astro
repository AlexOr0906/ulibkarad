---
import type { DoctorProfile } from '@/data/doctors';
import ArrowIcon from './ArrowIcon.astro';
import {doctorInformationRows} from '@/data/doctor-information';
interface Props { doctor: DoctorProfile; preview?: boolean; index?: number; presentation?: 'collection' | 'profile'; profileTarget?: string; }
const { doctor, preview = false, index = 0, presentation = 'collection', profileTarget } = Astro.props;
const base = import.meta.env.BASE_URL;
const demo = preview || !doctor.name || !doctor.specialty;
const image = `${base}${(doctor.portrait?.src ?? doctor.study ?? 'team/portrait-study-1.svg').replace(/^\/+/, '')}`;
const srcSet = doctor.portrait?.srcSet?.split(',').map(candidate => `${base}${candidate.trim().replace(/^\/+/, '')}`).join(', ');
---
{presentation === 'profile' ? (
 <article class="dp-card">
  <a class="dp-card-link" href={profileTarget} data-dp-open aria-label={`Познакомиться: ${doctor.name ?? 'пример профиля'}`}>
   <div class="dp-card-portrait"><img src={image} srcset={srcSet} sizes="(max-width:767px) 90vw, 33vw" alt={doctor.portrait?.alt ?? ''} width={doctor.portrait?.width ?? 800} height={doctor.portrait?.height ?? 1000} loading="lazy" style={`object-position:${doctor.portrait?.position ?? '50% 0%'};object-fit:${doctor.portrait?.fit ?? 'cover'}`} /></div>
   <div class="dp-card-copy"><h3>{doctor.name ?? 'Фамилия Имя Отчество'}</h3>{doctor.specialty && <p>{doctor.specialty}</p>}<span class="dp-card-action">Познакомиться <ArrowIcon /></span></div>
  </a>
  {preview && <p class="dp-caption">AI-портрет. Пример, не сотрудник клиники.</p>}
 </article>
) : (<article class="doctor-card" data-doctor-card data-preview={demo ? 'true' : undefined} aria-label={demo ? `Карточка ${index + 1}: сведения о враче готовятся` : doctor.name ?? undefined}>
  <div class="doctor-portrait">
    {doctor.portrait ? <img src={image} srcset={srcSet} sizes="(max-width: 767px) 88vw, 44vw" alt={doctor.portrait.alt} style={`object-position:${doctor.portrait.position ?? '50% 0%'}`} width={doctor.portrait.width??800} height={doctor.portrait.height??1000} loading="lazy" /> : <div class="team-no-photo"><span aria-hidden="true">{doctor.name?.split(' ').slice(0,2).map(n=>n[0]).join('')}</span><p>Портрет готовится</p></div>}
    {doctor.video && <video class="doctor-video" data-doctor-video data-src={`${base}${doctor.video.src.replace(/^\/+/, '')}`} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>}
    <span class="doctor-portrait-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="doctor-card-copy">
    <p class="doctor-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')} / Знакомство</p>
    <h3 class="text-[clamp(1.5rem,2.2vw,2rem)] font-light leading-tight tracking-[-.025em]">{doctor.name ?? 'Имя и фамилия'}</h3>
    <p class="mt-3 text-xs leading-relaxed text-graphite">{doctor.specialty ?? 'Специальность врача'}</p>
    {profileTarget ? (<a class="nav-link mt-5 inline-flex items-center gap-5 text-xs font-medium" href={profileTarget}>Подробнее о враче <ArrowIcon /></a>) : !demo && doctor.profileHref ? (
      <a class="nav-link mt-5 inline-flex items-center gap-5 text-xs font-medium" href={`${base}${doctor.profileHref.replace(/^\/+/, '')}`}>Подробнее о враче <ArrowIcon /></a>
    ) : (
      <button type="button" class="doctor-open mt-5 inline-flex items-center gap-5 py-2 text-xs font-medium" data-doctor-open data-information={JSON.stringify(doctorInformationRows(doctor.professionalInformation))} data-preview={demo ? 'true' : undefined} data-name={doctor.name ?? 'Имя и фамилия'} data-specialty={doctor.specialty ?? 'Специальность врача'} data-summary={doctor.summary ?? 'Краткое представление врача будет добавлено после согласования с клиникой.'} data-portrait={image} aria-haspopup="dialog" aria-controls="doctor-demo" aria-label={demo ? `Открыть карточку ${index + 1}` : `О враче: ${doctor.name}`}>Открыть карточку <ArrowIcon /></button>
    )}
    {demo && <noscript><p class="mt-4 text-xs text-graphite">Сведения о враче готовятся к публикации.</p></noscript>}
  </div>
</article>)}
