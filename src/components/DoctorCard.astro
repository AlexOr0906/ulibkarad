---
import type { DoctorProfile } from '@/data/doctors';
import ArrowIcon from './ArrowIcon.astro';
interface Props { doctor: DoctorProfile; preview?: boolean; }
const { doctor, preview = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const demo = preview || !doctor.name || !doctor.specialty || !doctor.portrait;
---
<article class="doctor-card" data-doctor-card data-preview={demo ? 'true' : undefined} data-reveal>
  <div class="doctor-portrait">
    {doctor.portrait ? (
      <img src={`${base}${doctor.portrait.src.replace(/^\/+/, '')}`} alt={doctor.portrait.alt} width="900" height="1200" loading="lazy" style={`object-position: ${doctor.portrait.position ?? '50% 20%'}`} />
    ) : (
      <div class="doctor-portrait-placeholder" role="img" aria-label="Место для согласованного портрета врача">
        <span class="eyebrow text-graphite">Демо. Макет карточки</span>
        <div><p class="text-xl font-light tracking-[-.02em] text-ink md:text-2xl">Портрет врача</p><p class="mt-2 text-xs text-graphite">Фотография будет добавлена</p></div>
        <span class="doctor-portrait-rule" aria-hidden="true"></span>
      </div>
    )}
  </div>
  <div class="pt-5 md:pt-6">
    <p class="eyebrow leading-relaxed text-graphite">{doctor.specialty ?? 'Специальность врача'}</p>
    <h3 class="mt-2 text-[clamp(1.55rem,2.5vw,2rem)] font-light leading-tight tracking-[-.025em]">{doctor.name ?? 'Имя и фамилия'}</h3>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-graphite">{doctor.summary ?? 'Краткая информация о враче. Сведения появятся после согласования с клиникой.'}</p>
    {demo ? (
      <details class="doctor-card-note mt-5 border-t border-graphite/25 pt-4">
        <summary class="flex cursor-pointer items-center justify-between gap-5 text-xs text-ink">О демокарточке<svg class="doctor-note-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <p class="mt-4 text-xs leading-relaxed text-graphite">Это пример оформления, не профиль сотрудника. После получения материалов здесь появятся согласованные имя, специальность, портрет и краткая информация. Отдельная страница врача пока не опубликована.</p>
      </details>
    ) : doctor.profileHref && (
      <a class="nav-link mt-5 inline-flex items-center gap-5 text-xs font-medium" href={`${base}${doctor.profileHref.replace(/^\/+/, '')}`}>Подробнее о враче <ArrowIcon /></a>
    )}
  </div>
</article>
