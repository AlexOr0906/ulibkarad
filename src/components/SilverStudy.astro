---
const base=import.meta.env.BASE_URL;
---
<span hidden data-silver-study-base={base}></span>
<script>
  if (new URLSearchParams(location.search).get('scene') === 'sculpture') {
    const base=document.querySelector<HTMLElement>('[data-silver-study-base]')?.dataset.silverStudyBase ?? '/';
    import('../lib/silver-study').then(module=>module.mountSilverStudy(base));
  }
</script>
