---
import {orthopedics} from '@/data/orthopedics';
import '@/styles/orthopedics.css';
interface Props { id?:string; autoMotion?:boolean; }
const {id='or-form',autoMotion=true}=Astro.props;
const asset=`${import.meta.env.BASE_URL}${orthopedics.visual.image}`;
const shape='M133 99C139 91 146 84 156 88C164 80 175 76 184 80C191 78 196 84 200 86C208 82 218 82 225 89C236 88 246 96 250 103C254 109 257 116 259 122C269 127 274 138 274 149C274 162 270 169 266 177C255 174 244 168 235 169C224 170 212 179 202 187C191 197 182 201 172 197C161 197 156 189 150 186C141 182 137 175 136 165C132 154 130 144 131 133C129 118 129 108 133 99Z';
---
<figure class="or-visual" data-or-scene data-or-auto-motion={autoMotion?'true':undefined}>
  <div class="or-stage">
    <svg class="or-form" viewBox="0 0 720 460" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
      <title id={`${id}-title`}>Иллюстративная форма зубной реставрации</title>
      <desc id={`${id}-desc`}>Контур раскрывается в белый объём под светом. Художественная сцена, не демонстрация лечения.</desc>
      <defs>
        <path id={`${id}-shape`} d={shape}/>
        <clipPath id={`${id}-cut`}><use href={`#${id}-shape`}/></clipPath>
        <symbol id={`${id}-image`} viewBox="110 55 180 155"><image href={asset} width="400" height="300" clip-path={`url(#${id}-cut)`} style="filter:grayscale(.95) brightness(1.06)"/></symbol>
        <symbol id={`${id}-contour`} viewBox="110 55 180 155"><use href={`#${id}-shape`} fill="none" stroke="currentColor" stroke-width=".8"/><path d="M140 101Q164 94 181 112Q190 123 207 113Q224 96 247 110M150 118Q162 143 167 181M183 123Q179 151 184 188M209 121Q215 141 211 164" fill="none" stroke="currentColor" stroke-width=".45" opacity=".6"/></symbol>
        <symbol id={`${id}-white`} viewBox="110 55 180 155"><use href={`#${id}-shape`} fill="white"/></symbol>
        <linearGradient id={`${id}-soft`} x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="white" stop-opacity="0"/><stop offset=".09" stop-color="white"/><stop offset="1" stop-color="white"/></linearGradient>
        <mask id={`${id}-reveal`} maskUnits="userSpaceOnUse" x="0" y="0" width="720" height="460"><rect width="720" height="460" fill="black"/><rect data-or-fill x="0" y="-20" width="720" height="510" fill={`url(#${id}-soft)`}/></mask>
        <mask id={`${id}-light-mask`}><use href={`#${id}-white`} x="160" y="48" width="400" height="344"/></mask>
        <linearGradient id={`${id}-shine`}><stop offset="0" stop-color="white" stop-opacity="0"/><stop offset=".5" stop-color="white" stop-opacity=".85"/><stop offset="1" stop-color="white" stop-opacity="0"/></linearGradient>
        <filter id={`${id}-shadow`} x="-50%" y="-200%" width="200%" height="500%"><feGaussianBlur stdDeviation="9"/></filter>
      </defs>
      <ellipse data-or-shadow cx="360" cy="373" rx="130" ry="13" fill="#101c24" opacity=".2" filter={`url(#${id}-shadow)`}/>
      <g data-or-object>
        <use class="or-base-form" href={`#${id}-image`} x="160" y="48" width="400" height="344"/>
        <use class="or-contour" data-or-contour href={`#${id}-contour`} x="160" y="48" width="400" height="344"/>
        <use href={`#${id}-image`} x="160" y="48" width="400" height="344" mask={`url(#${id}-reveal)`}/>
        <g mask={`url(#${id}-light-mask)`}><rect data-or-light x="0" y="0" width="150" height="460" fill={`url(#${id}-shine)`} opacity="0"/></g>
      </g>
    </svg>
  </div>
  <figcaption><span class="or-phase" data-or-phase>Форма под светом</span><span>{orthopedics.visual.caption}</span></figcaption>
</figure>
<script>
  import {initOrthopedicsScene} from './orthopedics-motion';
  document.querySelectorAll<HTMLElement>('[data-or-scene][data-or-auto-motion="true"]').forEach(root=>initOrthopedicsScene(root));
</script>
