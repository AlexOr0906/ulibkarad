---
import SectionHeading from './SectionHeading.astro';
import BracketDivider from './BracketDivider.astro';
import MetalEmblem from './MetalEmblem.astro';
import { approach } from '@/data/site';
const base = import.meta.env.BASE_URL;
interface Props { showDivider?: boolean; }
const { showDivider = true } = Astro.props;
---
<section id="approach" class="grain relative bg-ink py-24 text-white md:py-36" data-sc-act="flow">
  <div class="container-shell relative z-10">
    <SectionHeading index="02" label="Подход" title="Спокойно. Понятно. По делу." inverted />
    <div class="signature-story mt-16 md:mt-24">
      <div class="signature-stage grid gap-12 md:grid-cols-[1.15fr_1fr]">
      <div class="signature-panel" aria-label="Семейная подпись клиники">
        <p class="display text-[clamp(1.65rem,2.7vw,2.75rem)]">Забота начинается<br/>с внимания.</p>
        <div class="signature-mark-frame" aria-hidden="true">
          <img class="signature-base" src={`${base}brand/logo-chrome.svg`} width="913" height="952" alt="" loading="lazy" />
          <div class="signature-ink"><MetalEmblem class="signature-metal-emblem" /></div>
        </div>
        <div class="signature-words" aria-hidden="true"><span>Ясность</span><span>Внимание</span><span>Точность</span></div>
        <p class="mt-6 text-xs text-white/70">Демо. Предлагаемый подход клиники</p>
      </div>
      <div class="signature-copy divide-y divide-white/15 border-y border-white/15">
        {approach.map((item) => (
          <article class="signature-step flex items-center py-10" data-signature-step>
            <div>
              <h3 class="text-3xl font-semibold tracking-[-.05em] md:text-4xl">{item.title}</h3>
              <p class="mt-5 max-w-lg leading-relaxed text-white/75">{item.text}</p>
            </div>
          </article>
        ))}
      </div>
      </div>
    </div>
  </div>
  {showDivider && <BracketDivider tone="dark" />}
</section>
