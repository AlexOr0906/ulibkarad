<script>
  const introElement = document.querySelector<HTMLElement>('[data-of-intro]');
  if (introElement) {
    const intro = introElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = matchMedia('(min-width: 768px)');
    const lead = intro.querySelector<HTMLElement>('[data-of-lead]')!;
    const stage = intro.querySelector<HTMLElement>('[data-of-stage]')!;
    const primary = intro.querySelector<HTMLElement>('[data-of-main-photo]')!;
    const descriptor = intro.querySelector<HTMLElement>('.of-brand-descriptor')!;
    const aboutCopy = intro.querySelector<HTMLElement>('.of-about-copy')!;
    const shell = intro.querySelector<HTMLElement>('.of-shell')!;
    const photos = [...intro.querySelectorAll<HTMLImageElement>('.of-photo img')];
    let frame = 0, ready = false;
    let geometry = {width: 0, height: 0, span: 1, leadBottom: 0, leadRight: 0, brandBottom: 0, copyTop: 0, copyLeft: 0, primaryHeight: 0, primaryWidth: 0, header: 88};
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const smooth = (value: number) => { const p = clamp(value); return p * p * (3 - 2 * p); };
    // Shared camera poses. All layers interpolate on the same progress, never separate reveal timers.
    const desktopPoses = [
      [0, .70, .54, .66],
      [.34, .58, .47, 1.08],
      [.70, .30, .44, .99],
      [1, .30, .39, .90],
    ];
    const phonePoses = [
      [0, .50, .58, .84],
      [.34, .50, .49, 1.02],
      [.70, .50, .30, .76],
      [1, .50, .18, .72],
    ];
    function measure() {
      const active = ready && !reduced.matches && (innerHeight >= 620 || (!desktop.matches && innerHeight >= 540));
      intro.classList.toggle('of-scene-active', active);
      const r = intro.getBoundingClientRect();
      geometry = {width: stage.clientWidth, height: stage.clientHeight, span: Math.max(1, intro.offsetHeight - innerHeight), leadBottom: lead.getBoundingClientRect().bottom - r.top, leadRight: lead.getBoundingClientRect().right - r.left, brandBottom: descriptor.getBoundingClientRect().bottom - r.top, copyTop: aboutCopy.getBoundingClientRect().top - r.top, copyLeft: aboutCopy.getBoundingClientRect().left - r.left, primaryHeight: primary.offsetHeight, primaryWidth: primary.offsetWidth, header: parseFloat(getComputedStyle(intro).getPropertyValue('--of-header-height')) || (desktop.matches ? 88 : 72)};
      if (active) {
        const poses = desktop.matches ? desktopPoses : phonePoses;
        const left = shell.getBoundingClientRect().left - r.left;
        const right = desktop.matches ? aboutCopy.getBoundingClientRect().left - r.left - 24 : geometry.width - left;
        // One photographic frame resolves into the free reading lane.
        for (const [index, scale] of (desktop.matches ? [[2,.99],[3,.90]] : [[2,.76],[3,.72]])) {
          poses[index][1] = (left + (right - left) / 2) / geometry.width;
          poses[index][3] = Math.min(scale, (right - left) * .88 / primary.offsetWidth);
        }
      }
      // Release the photographic world before long, narrow-phone copy reaches it.
      // After release the group and copy move together in ordinary flow.
      let release = 0;
      if (active && !desktop.matches) {
        const last = phonePoses[3];
        const finalBottom = geometry.header + geometry.height * last[2] + geometry.primaryHeight * last[3] / 2;
        release = Math.max(0, finalBottom + 48 - (aboutCopy.getBoundingClientRect().top - r.top - geometry.span));
      }
      intro.style.setProperty('--of-release-offset', `${release}px`);
      geometry.span = Math.max(1, geometry.span - release);
      intro.dataset.ofSpan = String(geometry.span);
      queue();
    }
    function update() {
      frame = 0;
      if (!intro.classList.contains('of-scene-active')) {
        intro.style.setProperty('--of-shade', '0'); intro.style.setProperty('--of-scene-ink', '#273037'); return;
      }
      const p = clamp(-intro.getBoundingClientRect().top / geometry.span);
      const poses = desktop.matches ? desktopPoses : phonePoses;
      let i = 0; while (i < poses.length - 2 && p > poses[i + 1][0]) i++;
      const a = poses[i], b = poses[i + 1], t = smooth((p - a[0]) / (b[0] - a[0]));
      const pose = a.map((v, index) => v + (b[index] - v) * t);
      // Short phone screens keep the first photograph below the immediately available CTA.
      const phoneStart = desktop.matches ? 0 : Math.max(0, geometry.leadBottom - geometry.header + geometry.primaryHeight * .84 / 2 + 24 - geometry.height * .58);
      let mainY = pose[2] * geometry.height + phoneStart * (1 - smooth(p / .34));
      let mainX = pose[1] * geometry.width;
      if (!desktop.matches) {
        const travel = Math.max(0, -intro.getBoundingClientRect().top);
        mainY = Math.max(mainY, geometry.leadBottom - travel - geometry.header + 24 + geometry.primaryHeight * pose[3] / 2);
      } else {
        const travel = Math.max(0, -intro.getBoundingClientRect().top);
        mainY = Math.max(mainY, geometry.brandBottom - travel - geometry.header + 24 + geometry.primaryHeight * pose[3] / 2);
        const halfWidth = geometry.primaryWidth * pose[3] / 2;
        const halfHeight = geometry.primaryHeight * pose[3] / 2;
        for (let pass = 0; pass < 3; pass++) {
          const clearance = smooth((geometry.leadRight + 48 - (mainX - halfWidth)) / 48);
          const belowLead = geometry.leadBottom - travel - geometry.header + 24 + halfHeight;
          mainY += Math.max(0, belowLead - mainY) * clearance;
          const stageTop = geometry.header - Math.max(0, travel - geometry.span);
          const verticalGap = geometry.copyTop - travel - (stageTop + mainY + halfHeight);
          mainX = Math.min(mainX, geometry.copyLeft - 24 - halfWidth + Math.max(0, verticalGap));
        }
        if (mainX - halfWidth < geometry.leadRight) {
          mainY = Math.max(mainY, geometry.leadBottom - travel - geometry.header + 24 + halfHeight);
          const stageTop = geometry.header - Math.max(0, travel - geometry.span);
          const verticalGap = geometry.copyTop - travel - (stageTop + mainY + halfHeight);
          mainX = Math.min(mainX, geometry.copyLeft - 24 - halfWidth + Math.max(0, verticalGap));
        }
      }
      intro.style.setProperty('--of-main-x', `${mainX}px`);
      intro.style.setProperty('--of-main-y', `${mainY}px`);
      intro.style.setProperty('--of-main-scale', String(pose[3]));
      const shade = smooth((p - .24) / .60);
      intro.style.setProperty('--of-shade', String(shade));
      const rgb = [238,241,243].map((v, index) => v + ([39,48,55][index] - v) * shade);
      const luminance = rgb.map(v => v / 255).map(v => v <= .04045 ? v / 12.92 : ((v + .055) / 1.055) ** 2.4).reduce((sum, v, index) => sum + v * [.2126,.7152,.0722][index], 0);
      intro.style.setProperty('--of-scene-ink', shade < .06 ? '#273037' : shade > .96 ? '#f2f4f5' : luminance > .179 ? '#000000' : '#ffffff');
      intro.dataset.ofProgress = p.toFixed(4);
    }
    function queue() { if (!frame) frame = requestAnimationFrame(update); }
    addEventListener('scroll', queue, {passive: true});
    addEventListener('resize', measure, {passive: true});
    addEventListener('of-header-resize', measure);
    reduced.addEventListener('change', measure);
    Promise.all(photos.map(photo => photo.decode().catch(() => {}))).then(() => { ready = photos.every(photo => photo.naturalWidth > 0); measure(); });
    document.fonts.ready.then(measure);
    measure();

    const cards = [...document.querySelectorAll<HTMLDetailsElement>('[data-of-direction]')];
    const animations = new Map<HTMLDetailsElement, Animation>();
    const targets = new Map<HTMLDetailsElement, boolean>();
    function setOpen(card: HTMLDetailsElement, open: boolean) {
      const start = card.getBoundingClientRect().height;
      animations.get(card)?.cancel(); animations.delete(card);
      targets.set(card, open);
      const panel = card.querySelector<HTMLElement>('.of-direction-panel')!;
      if (reduced.matches) { card.open = open; panel.inert = false; return; }
      card.open = true; panel.inert = !open;
      const end = open ? card.getBoundingClientRect().height : card.querySelector('summary')!.getBoundingClientRect().height + 1;
      const animation = card.animate({height: [`${start}px`, `${end}px`]}, {duration: 330, easing: 'cubic-bezier(.22,1,.36,1)'});
      animations.set(card, animation);
      animation.onfinish = () => { card.open = open; panel.inert = false; animations.delete(card); };
    }
    cards.forEach(card => card.querySelector('summary')!.addEventListener('click', event => {
      event.preventDefault();
      const willOpen = !(targets.get(card) ?? card.open);
      if (willOpen) cards.filter(other => other !== card && other.open).forEach(other => setOpen(other, false));
      setOpen(card, willOpen);
    }));
    reduced.addEventListener('change', () => { if (reduced.matches) animations.forEach(animation => animation.finish()); });
    addEventListener('resize', () => animations.forEach(animation => animation.finish()), {passive: true});

    const dialog = document.querySelector<HTMLDialogElement>('#of-visit-dialog')!;
    const topic = dialog.querySelector<HTMLElement>('#of-dialog-topic')!;
    let trigger: HTMLElement | null = null;
    document.querySelectorAll<HTMLAnchorElement>('[data-of-visit]').forEach(link => link.addEventListener('click', event => {
      event.preventDefault(); trigger = link;
      topic.hidden = !link.dataset.ofTopic; topic.textContent = link.dataset.ofTopic ? `Тема разговора: ${link.dataset.ofTopic}` : '';
      dialog.showModal(); document.body.classList.add('of-dialog-open');
    }));
    dialog.addEventListener('close', () => { document.body.classList.remove('of-dialog-open'); trigger?.focus({preventScroll: true}); });
    dialog.addEventListener('click', event => { const r = dialog.getBoundingClientRect(); if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) dialog.close(); });
    dialog.addEventListener('keydown', event => {
      if (event.key !== 'Tab') return;
      const controls = [...dialog.querySelectorAll<HTMLButtonElement>('button')];
      if (event.shiftKey && document.activeElement === controls[0]) { event.preventDefault(); controls.at(-1)?.focus(); }
      else if (!event.shiftKey && document.activeElement === controls.at(-1)) { event.preventDefault(); controls[0]?.focus(); }
    });
  }
</script>
