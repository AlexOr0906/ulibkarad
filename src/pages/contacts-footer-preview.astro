---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactsSection from '../components/contacts-footer/ContactsSection.astro';
import ClinicFooter from '../components/contacts-footer/ClinicFooter.astro';
---
<BaseLayout title="Ортофэмили: контакты и футер, предпросмотр" description="Демонстрационный вариант завершающих блоков. Контакты и реквизиты ожидают подтверждения.">
  <div class="cf-preview" id="top">
    <header class="cf-preview-bar cf-wrap"><h1>Ортофэмили <span>Предпросмотр контактов и футера</span></h1><a href="#contacts">К контактам</a></header>
    <main id="main-content"><ContactsSection /></main>
    <ClinicFooter />
  </div>
</BaseLayout>
