---
import '@/styles/orthofamily-wordmark.css';
const base = import.meta.env.BASE_URL;
---
<div class="of-intro" data-of-intro>
  <div class="of-scene-ground" aria-hidden="true"><div class="of-scene-shade"></div></div>
  <section class="of-opening" id="of-top" aria-labelledby="of-name">
    <div class="of-shell">
      <div class="of-opening-meta"><p>Магнитогорск</p><p>Демо-концепция</p></div>
      <h1 class="of-title of-brand-wordmark" id="of-name"><span>OrtoFamily</span></h1>
      <p class="of-brand-descriptor">Стоматология · Ортодонтия</p>
        <div class="of-lead" data-of-lead>
          <p class="of-hero-description">Стоматология<br/>для взрослых и детей.</p>
          <a class="of-button" href="#of-visit" data-of-visit>Обсудить визит <span aria-hidden="true">↗</span></a>
        </div>
    </div>
  </section>
  <div class="of-scene-world">
    <div class="of-scene-stage" data-of-stage>
        <figure class="of-photo of-photo-main" data-of-main-photo>
          <img src={`${base}orthofamily/mirror-hand-1280.webp`} srcset={`${base}orthofamily/mirror-hand-640.webp 640w, ${base}orthofamily/mirror-hand-1280.webp 1280w`} sizes="(max-width: 767px) 90vw, 52vw" alt="Иллюстративный кадр: рука в перчатке держит стоматологическое зеркало." width="1280" height="1599" fetchpriority="high" />
          <figcaption>Иллюстративный кадр</figcaption>
        </figure>
        <figure class="of-photo of-photo-near" data-of-near-photo>
          <div class="of-near-frame"><img src={`${base}orthofamily/ceramic-crown-800.webp`} srcset={`${base}orthofamily/ceramic-crown-400.webp 400w, ${base}orthofamily/ceramic-crown-800.webp 800w`} sizes="(max-width: 767px) 58vw, 30vw" alt="Иллюстративная стоматологическая деталь: керамическая коронка на серебристой поверхности." width="800" height="600" decoding="async" /></div>
          <figcaption>Демонстрационные изображения.<br/>Не фотографии клиники.</figcaption>
        </figure>
    </div>
  </div>
  <section class="of-about" id="of-about" aria-labelledby="of-about-title">
    <div class="of-shell of-about-grid">
      <div class="of-about-copy">
        <h2 id="of-about-title">Внимание<br/>к каждому.</h2>
        <p>Знакомство со стоматологией начинается с разговора. Важно понять ваш запрос, спокойно обсудить возможные шаги и ответить на вопросы.</p>
        <p>Для взрослых и детей — в одной клинике и с вниманием к особенностям каждого.</p>
        <a class="of-text-link" href="#of-directions">Посмотреть направления <span aria-hidden="true">↘</span></a>
      </div>
    </div>
  </section>
</div>
