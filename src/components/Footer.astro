---
import { navigation } from '@/data/site';
import BrandLogo from './BrandLogo.astro';
import ArrowIcon from './ArrowIcon.astro';
---
<footer class="bg-ink pb-8 pt-20 text-white md:pt-28">
  <div class="container-shell">
    <div class="grid gap-16 md:grid-cols-[2fr_1fr]">
      <div>
        <a href="#top" class="footer-brand inline-block" aria-label="Дело в улыбке — на главную"><BrandLogo light /></a>
        <p class="mt-8 max-w-md text-sm leading-relaxed text-white/65">Дело в улыбке. Внимание к человеку, которое начинается со знакомства.</p>
        <a href="#appointment" class="nav-link mt-8 inline-flex items-center gap-4 text-lg text-white">Обсудить визит <ArrowIcon /></a>
      </div>
      <div class="grid grid-cols-2 gap-8">
        <div><p class="eyebrow mb-6 text-white/55">Навигация</p>{navigation.map((item) => <a class="nav-link mb-3 block w-fit text-sm hover:text-silver" href={item.href}>{item.label}</a>)}</div>
        <div><p class="eyebrow mb-6 text-white/65">О проекте</p><p class="text-sm leading-relaxed text-white/65">Демо для обсуждения<br/>Материалы уточняются</p><button data-open-concept type="button" class="nav-link mt-3 text-sm text-white underline" aria-haspopup="dialog" aria-controls="concept-dialog">О концепции</button></div>
      </div>
    </div>
    <div class="mt-20 flex flex-col gap-4 border-t border-white/15 pt-6 text-[10px] uppercase tracking-[.14em] text-white/65 md:mt-32 md:flex-row md:justify-between">
      <p>© 2026 · Концепт главной страницы</p><p>Магнитогорск · Не является публичной офертой</p>
    </div>
  </div>
</footer>
