---
const base = import.meta.env.BASE_URL;
const directions = [
  { title: 'Взрослая терапия', text: 'Вопросы здоровья зубов и понятное обсуждение вариантов помощи. Начинаем со знакомства и вашего запроса.', image: 'mirror-hand-640.webp', alt: 'Иллюстративная деталь стоматологического зеркала.', position: '60% 10%' },
  { title: 'Детская терапия', text: 'Внимание к маленькому пациенту и спокойный разговор с родителями. Важно учитывать возраст и особенности ребёнка.', image: 'care-detail-640.webp', alt: 'Иллюстративная деталь аккуратного ухода: салфетка и перчатка.', position: '40% 50%' },
  { title: 'Ортопедия', text: 'Восстановление зубов. Обсуждение функции, эстетики и возможных решений с учётом вашего запроса.', image: 'ceramic-crown-400.webp', alt: 'Демонстрационный снимок керамической зубной коронки.', position: '50% 50%' },
  { title: 'Ортодонтия', text: 'Вопросы прикуса и положения зубов. Знакомство с направлением начинается с консультации.', image: 'clear-aligner-400.webp', alt: 'Демонстрационный снимок прозрачной ортодонтической конструкции.', position: '50% 50%' },
];
---
<section class="of-directions" id="of-directions" aria-labelledby="of-directions-title" data-sc-act="flow">
  <div class="of-shell of-directions-grid">
    <header class="of-directions-heading">
      <p class="of-eyebrow">Направления</p>
      <h2 id="of-directions-title">С чего<br/> начнём?</h2>
      <p>Демонстрационная структура направлений. Подробности будут подтверждены клиникой.</p>
    </header>
    <div class="of-direction-list">
      {directions.map((item, index) => (
        <details class="of-direction" open={index === 0} data-of-direction>
          <summary><span>{item.title}</span><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M12 4v16" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></summary>
          <div class="of-direction-panel">
            <p>{item.text}</p>
            <img src={`${base}orthofamily/${item.image}`} alt={item.alt} width="400" height="300" loading="lazy" decoding="async" style={`object-position:${item.position}`} />
            <a class="of-text-link" href="#of-visit" data-of-visit data-of-topic={item.title}>Обсудить направление <span aria-hidden="true">↗</span></a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
