---
import InternalPageLayout from '@/layouts/InternalPageLayout.astro';
import ArrowIcon from '@/components/ArrowIcon.astro';
import {siteNavigation} from '@/data/site-preview-navigation';
const base=import.meta.env.BASE_URL;
const nav=siteNavigation(base);
---
<InternalPageLayout title="Ортопедия: выбор визуальной концепции" description="Два статичных демонстрационных макета: человек и улыбка, керамика и свет." navigation={nav.navigation} footerNavigation={nav.footerNavigation} transitionHrefs={[]}>
  <div class="oc-page">
    <header class="oc-intro oc-shell">
      <p class="oc-kicker">OrthoFamily · Визуальное обсуждение</p>
      <h1>Два взгляда<br />на ортопедию.</h1>
      <div class="oc-intro-bottom"><p>Сначала выбираем образ.<br />Затем создаём движение под него.</p><nav aria-label="Сравнение концепций"><a href="#concept-human">Человек и улыбка <ArrowIcon /></a><a href="#concept-material">Керамика и свет <ArrowIcon /></a></nav></div>
    </header>
    <section id="concept-human" class="oc-concept" aria-labelledby="human-title" tabindex="-1">
      <div class="oc-section-caption oc-shell"><h2 id="human-title">Человек и улыбка</h2><p>Теплее. Ближе. Естественнее.</p></div>
      <div class="oc-human oc-artboard oc-shell">
        <img src={`${base}orthopedics-concepts/human-smile-v1.png`} alt="Демонстрационный AI-портрет улыбающейся женщины. Не реальный пациент или сотрудник клиники." width="1536" height="1024" fetchpriority="high" />
        <div class="oc-human-copy"><p class="oc-service-label">Ортопедия</p><h3>Ближе<br />к человеку.</h3><p class="oc-copy-note">Место для согласованного<br />описания направления.</p><a class="oc-cta" href={`${base}#contacts`}>Обсудить визит <ArrowIcon /></a></div>
        <p class="oc-image-note">AI-демо. Не пациент клиники.<br />Не иллюстрация результата лечения.</p>
      </div>
      <div class="oc-concept-notes oc-shell" id="human-notes"><p class="oc-note-label">Как это может двигаться</p><p>Начинаем с небольшого кадра улыбки. По прокрутке рамка раскрывается, становится виден человек целиком. Типографика и фотография движутся независимо. Без вращения зуба и бесконечного приближения.</p><p class="oc-static-note">Сейчас статичный макет.<br />Изображение создано для выбора концепции.</p></div>
    </section>
    <section id="concept-material" class="oc-concept oc-material-section" aria-labelledby="material-title" tabindex="-1">
      <div class="oc-section-caption oc-shell"><h2 id="material-title">Керамика и свет</h2><p>Тактильность. Форма. Точность.</p></div>
      <div class="oc-material oc-artboard oc-shell">
        <img src={`${base}orthopedics-concepts/ceramic-material-v1.png`} alt="Абстрактная AI-иллюстрация светлой керамической поверхности с серебристым краем на графитовом фоне. Не зуб и не медицинское изделие." width="1536" height="1024" loading="lazy" />
        <div class="oc-material-copy"><p class="oc-service-label">Ортопедия</p><h3>Форма.<br />В деталях.</h3><p class="oc-copy-note">Место для согласованного<br />описания направления.</p><a class="oc-material-link" href={`${base}#contacts`}>Обсудить визит <ArrowIcon /></a></div>
        <p class="oc-material-image-note">Художественная AI-иллюстрация материала.<br />Не демонстрация медицинской технологии.</p>
      </div>
      <div class="oc-concept-notes oc-shell"><p class="oc-note-label">Как это может двигаться</p><p>Крупная фактура остаётся основой кадра. По прокрутке раскрывается изгиб поверхности, а свет подчёркивает тонкий край. Для настоящей смены освещения потребуются согласованные световые состояния.</p><p class="oc-static-note">Сейчас статичный макет.<br />Без целого зуба и медицинских деталей.</p></div>
    </section>
    <div class="oc-review-note oc-shell"><p>Оба варианта демонстрационные. Медицинское наполнение ожидается от клиники. Текущая ортопедия не заменена.</p><a href={`${base}orthopedics/`}>Вернуться к текущей странице <ArrowIcon /></a></div>
  </div>
</InternalPageLayout>
<style>
 .oc-page { color:#273037; }
 .oc-shell { width:min(calc(100% - 7rem),90rem); margin-inline:auto; }
 .oc-intro { padding:44px 0 64px; }
 .oc-kicker { font-size:.75rem; color:#596770; margin-bottom:28px; }
 .oc-intro h1 { font-size:clamp(2.8rem,6vw,5.8rem); font-weight:300; line-height:1.08; letter-spacing:-.055em; }
 .oc-intro-bottom { display:flex; justify-content:space-between; gap:32px; align-items:end; margin-top:36px; }
 .oc-intro-bottom>p { font-size:.95rem; color:#596770; line-height:1.8; }
 .oc-intro nav { display:flex; gap:24px; flex-wrap:wrap; }
 .oc-intro a { display:inline-flex; align-items:center; gap:16px; min-height:44px; border-bottom:1px solid #aeb8be; font-size:.85rem; }
 .oc-intro a:hover,.oc-intro a:focus-visible { border-color:#273037; }
 .oc-concept { padding-bottom:72px; }
 .oc-section-caption { display:flex; justify-content:space-between; gap:24px; align-items:baseline; padding:24px 0; border-top:1px solid #c9cdd1; }
 .oc-section-caption h2 { font-size:1.05rem; font-weight:400; }
 .oc-section-caption>p { font-size:.75rem; color:#596770; }
 .oc-artboard { position:relative; isolation:isolate; overflow:hidden; min-height:640px; }
 .oc-artboard>img { display:block; position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-1; }
 .oc-human { background:#e4e8eb; }
 .oc-human>img { object-position:65% 18%; }
 .oc-human-copy { padding:62px; width:55%; }
 .oc-service-label { font-size:.8rem; margin-bottom:48px; }
 .oc-artboard h3 { font-size:clamp(3rem,6.3vw,6.8rem); line-height:1.03; font-weight:300; letter-spacing:-.06em; }
 .oc-copy-note { margin-top:26px; font-size:.85rem; line-height:1.8; }
 .oc-cta { display:inline-flex; align-items:center; gap:36px; min-height:50px; padding:15px 20px; background:#273037; color:#fff!important; margin-top:30px; font-size:.8rem; }
 .oc-image-note { position:absolute; right:28px; bottom:22px; color:#273037; font-size:.65rem; line-height:1.7; text-align:right; background:rgb(238 241 243 / .88); padding:8px 12px; }
 .oc-concept-notes { display:grid; grid-template-columns:.6fr 1.5fr .8fr; gap:48px; padding-block:28px 0; }
 .oc-note-label { font-size:.75rem; color:#596770; }
 .oc-concept-notes>p:nth-child(2) { font-size:.9rem; line-height:1.9; }
 .oc-static-note { font-size:.75rem; line-height:1.9; color:#596770; }
 .oc-material { background:#273037; color:#f2f4f5; min-height:740px; }
 .oc-material>img { object-position:center; }
 .oc-material-copy { padding:62px; max-width:55%; }
 .oc-material .oc-copy-note { color:#e2e7ea; }
 .oc-material-link { display:inline-flex; align-items:center; min-height:44px; gap:32px; font-size:.8rem; margin-top:28px; text-decoration:underline; text-underline-offset:6px; }
 .oc-material-image-note { position:absolute; right:28px; bottom:22px; padding:9px 12px; background:rgb(39 48 55 / .82); color:#f2f4f5; font-size:.65rem; line-height:1.8; text-align:right; }
 .oc-review-note { padding:0 0 64px; display:flex; align-items:center; justify-content:space-between; gap:32px; }
 .oc-review-note p { max-width:50rem; font-size:.8rem; color:#596770; line-height:1.9; }
 .oc-review-note a { display:inline-flex; flex:none; align-items:center; gap:16px; min-height:44px; font-size:.8rem; text-decoration:underline; text-underline-offset:5px; }
 @media(max-width:1100px) and (min-width:768px) {
  .oc-shell { width:calc(100% - 4rem); }
  .oc-human-copy,.oc-material-copy { padding:40px; }
  .oc-artboard { min-height:580px; }
  .oc-material { min-height:660px; }
  .oc-concept-notes { gap:24px; }
 }
 @media(max-width:767px) {
  .oc-shell { width:calc(100% - 2rem); }
  .oc-intro { padding:32px 0 40px; }
  .oc-intro-bottom { display:block; margin-top:24px; }
  .oc-intro nav { display:block; margin-top:20px; }
  .oc-intro nav a { display:flex; justify-content:space-between; }
  .oc-section-caption { display:block; }
  .oc-section-caption>p { margin-top:10px; }
  .oc-human { min-height:0; display:flex; flex-direction:column; }
  .oc-human-copy { order:2; width:100%; padding:28px; background:#e4e8eb; }
  .oc-service-label { margin-bottom:30px; }
  .oc-artboard h3 { font-size:clamp(2.8rem,12vw,4.7rem); }
  .oc-human>img { order:0; position:static; z-index:auto; aspect-ratio:1; height:auto; width:100%; object-position:80% center; }
  .oc-image-note { order:1; position:static; margin:0; padding:14px 20px; text-align:left; font-size:.65rem; background:#e4e8eb; }
  .oc-material { min-height:760px; }
  .oc-material-copy { padding:28px; max-width:none; }
  .oc-material>img { object-position:65% center; }
  .oc-material-image-note { left:16px; right:16px; bottom:16px; text-align:left; }
  .oc-concept-notes { display:block; padding-top:24px; }
  .oc-concept-notes>p+p { margin-top:16px; }
  .oc-concept { padding-bottom:48px; }
  .oc-review-note { display:block; padding-bottom:40px; }
  .oc-review-note a { margin-top:20px; }
 }
</style>
