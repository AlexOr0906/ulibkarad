---
// Temporary local composition. The shared service layout belongs to the second account.
import InternalPageLayout from '@/layouts/InternalPageLayout.astro';
import OrthopedicsPreviewIntro from '@/components/orthopedics/OrthopedicsPreviewIntro.astro';
import OrthopedicsPageContent from '@/components/orthopedics/OrthopedicsPageContent.astro';
import {orthopedics} from '@/data/orthopedics';
import {siteNavigation} from '@/data/site-preview-navigation';
const nav=siteNavigation(import.meta.env.BASE_URL);
---
<InternalPageLayout title={`${orthopedics.title} · Прототип`} description={orthopedics.description} homeHref={nav.home} contactHref={nav.contactHref} navigation={nav.navigation} footerNavigation={nav.footerNavigation} transitionHrefs={nav.transitionHrefs}>
  <OrthopedicsPreviewIntro />
  <OrthopedicsPageContent doctorsHref={`${nav.home}#doctors`} contactHref={nav.contactHref} />
</InternalPageLayout>
