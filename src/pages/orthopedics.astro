---
import InternalPageLayout from '@/layouts/InternalPageLayout.astro';
import ServicePageContent from '@/components/services/ServicePageContent.astro';
import OrthopedicsVisual from '@/components/orthopedics/OrthopedicsVisual.astro';
import OrthopedicsPageContent from '@/components/orthopedics/OrthopedicsPageContent.astro';
import {orthopedics} from '@/data/orthopedics';
import type {ServicePageData} from '@/data/service-page';
import {siteNavigation} from '@/data/site-preview-navigation';
const nav=siteNavigation(import.meta.env.BASE_URL);
const hero:ServicePageData={
  id:'prosthodontics',title:orthopedics.title,
  lead:orthopedics.statement.join(' '),
  breadcrumbs:[{label:'Главная',href:nav.home},{label:orthopedics.title}],
  demoNotice:'Прототип направления к открытию. Медицинское наполнение будет добавлено после согласования с клиникой.',
};
---
<InternalPageLayout title="Ортопедия · Прототип" description={orthopedics.description} homeHref={nav.home} contactHref={nav.contactHref} navigation={nav.navigation} footerNavigation={nav.footerNavigation} transitionHrefs={nav.transitionHrefs} activeHref={nav.orthopedics}>
  <ServicePageContent data={hero}>
    <div class="or-shell" slot="scene"><OrthopedicsVisual id="or-service-form" autoMotion={false} /></div>
    <OrthopedicsPageContent autoMotion={false} doctorsHref={`${nav.home}#doctors`} contactHref={nav.contactHref} />
  </ServicePageContent>
</InternalPageLayout>
