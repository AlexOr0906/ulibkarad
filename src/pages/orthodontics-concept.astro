---
import InternalPageLayout from '@/layouts/InternalPageLayout.astro';
import OrthodonticsArc from '@/components/orthodontics-concept/OrthodonticsArc.astro';
import ServiceEditorial from '@/components/services/ServiceEditorial.astro';
import {siteNavigation} from '@/data/site-preview-navigation';
const nav=siteNavigation(import.meta.env.BASE_URL);
---
<InternalPageLayout title="Ортодонтия" description="Ортодонтическое направление OrthoFamily в Магнитогорске." navigation={nav.navigation} footerNavigation={nav.footerNavigation} homeHref={nav.home} contactHref={nav.contactHref} transitionHrefs={nav.transitionHrefs}>
  <OrthodonticsArc contactHref={nav.contactHref} />
  <ServiceEditorial service="orthodontics" />
</InternalPageLayout>
