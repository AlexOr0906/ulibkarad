---
import '@/styles/site-functions.css';
import '@/styles/reading-mode.css';
---
<script is:inline>
document.documentElement.dataset.siteJs='true';
function restoreReading(){try{const r=JSON.parse(localStorage.getItem('of-reading')||'null');document.documentElement.dataset.reading=r?.enabled?'on':'off';document.documentElement.dataset.textSize=['normal','large','largest'].includes(r?.size)?r.size:'normal';document.documentElement.dataset.contrast=['light','dark','cream'].includes(r?.contrast)?r.contrast:'light';}catch{}}
restoreReading();window.addEventListener('pageshow',restoreReading);window.addEventListener('storage',restoreReading);
</script>
