---
import '@/styles/orthofamily-wordmark.css';
import '@/styles/opening-transition.css';
import OrthofamilyIcon from './OrthofamilyIcon.astro';
const base = import.meta.env.BASE_URL;
---
<div class="of-intro of-opening-transition" id="of-top" data-of-intro>
  <div class="of-scene-ground" aria-hidden="true"></div>
  <div class="of-hero">
  <div class="of-hero-frame">
  <section class="of-opening" aria-labelledby="of-name">
    <div class="of-shell">
      <div class="of-opening-meta"><p>Магнитогорск</p><p>Для взрослых и детей</p></div>
      <div class="of-opening-copy">
      <h1 class="of-title of-brand-wordmark" id="of-name"><span>OrthoFamily</span></h1>
      <p class="of-brand-descriptor">Стоматология для всей семьи</p>
        <div class="of-lead" data-of-lead>
          <p class="of-hero-description">Стоматология<br/>для взрослых и детей.</p>
          <a class="of-button" href="#of-visit">Обсудить визит <OrthofamilyIcon /></a>
          <p class="of-hero-note">AI-иллюстрация</p>
        </div>
      </div>
    </div>
  </section>
  <div class="of-scene-world">
    <div class="of-scene-stage" data-of-stage>
        <figure class="of-photo of-photo-main" data-of-main-photo style={`--of-object-mask: url("${base}orthofamily/aligner-object-v1-1200.webp")`}>
          <div class="of-swipe-plane"><div class="of-object-surface"><img src={`${base}orthofamily/aligner-object-v1-1200.webp`} srcset={`${base}orthofamily/aligner-object-v1-640.webp 640w, ${base}orthofamily/aligner-object-v1-1200.webp 1200w`} sizes="(max-width: 767px) 90vw, 44vw" alt="Иллюстративное изображение: прозрачный ортодонтический элайнер с серебристыми отражениями." width="1448" height="1086" fetchpriority="high" /></div></div>
        </figure>
    </div>
  </div>
  </div>
  </div>
  <section class="of-about" id="of-about" aria-labelledby="of-about-title">
    <div class="of-shell of-about-grid">
      <div class="of-about-copy">
        <h2 id="of-about-title">Внимание<br/>к каждому.</h2>
        <p>Знакомство со стоматологией начинается с разговора. Важно понять ваш запрос, спокойно обсудить возможные шаги и ответить на вопросы.</p>
        <p>Для взрослых и детей — в одной клинике и с вниманием к особенностям каждого.</p>
        <a class="of-text-link" href="#of-directions">Посмотреть направления <OrthofamilyIcon direction="se" /></a>
      </div>
    </div>
  </section>
</div>
