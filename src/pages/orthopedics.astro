---
import InternalPageLayout from '@/layouts/InternalPageLayout.astro';
import ServicePageContent from '@/components/services/ServicePageContent.astro';
import OrthopedicsHumanVisual from '@/components/orthopedics/OrthopedicsHumanVisual.astro';
import ServiceEditorial from '@/components/services/ServiceEditorial.astro';
import {orthopedics} from '@/data/orthopedics';
import type {ServicePageData} from '@/data/service-page';
import {siteNavigation} from '@/data/site-preview-navigation';
const nav=siteNavigation(import.meta.env.BASE_URL);
const hero:ServicePageData={
  id:'prosthodontics',title:orthopedics.title,
  breadcrumbs:[{label:'Главная',href:nav.home},{label:orthopedics.title}],
};
---
<InternalPageLayout title="Ортопедия" description={orthopedics.description} homeHref={nav.home} contactHref={nav.contactHref} navigation={nav.navigation} footerNavigation={nav.footerNavigation} transitionHrefs={nav.transitionHrefs} activeHref={nav.orthopedics}>
  <ServicePageContent data={hero}>
    <div class="or-shell" slot="scene"><OrthopedicsHumanVisual autoMotion={false} /></div>
    <ServiceEditorial service="orthopedics" />
  </ServicePageContent>
</InternalPageLayout>
