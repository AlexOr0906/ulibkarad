---
import type {AboutPhoto} from '@/data/about-clinic';
import AboutReveal from './AboutReveal.astro';
interface Props { photo: AboutPhoto; }
const {photo}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<figure class="ac-media">
  <AboutReveal kind="media">
    <div class:list={['ac-media-visual',{'ac-media-placeholder':!photo.src}]}>
      {photo.src ? <img class="ac-clinic-photo" src={`${base}${photo.src.replace(/^\/+/, '')}`} alt={photo.alt} width="1000" height="1100" style={`object-position:${photo.position}`} fetchpriority="high" /> : <>
        <span class="ac-media-label">Фотография клиники</span>
        <img class="ac-media-emblem" src={`${base}brand/logo-chrome.svg`} alt="" width="921" height="960" aria-hidden="true" />
        <span class="ac-media-status">Материалы готовятся</span>
      </>}
    </div>
  </AboutReveal>
  <figcaption>{photo.caption}</figcaption>
</figure>
