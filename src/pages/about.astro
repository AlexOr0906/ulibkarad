---
import InternalPageLayout from '@/layouts/InternalPageLayout.astro';
import AboutPageContent from '@/components/about-clinic/AboutPageContent.astro';
import {siteNavigation} from '@/data/site-preview-navigation';
const nav=siteNavigation(import.meta.env.BASE_URL);
---
<InternalPageLayout title="О клинике" description="Знакомство с OrthoFamily. Стоматология для всей семьи в Магнитогорске." homeHref={nav.home} contactHref={nav.contactHref} navigation={nav.navigation} footerNavigation={nav.footerNavigation} transitionHrefs={nav.transitionHrefs} contentOwnsHeaderOffset>
  <AboutPageContent homeHref={nav.home} doctorsHref={`${nav.home}#doctors`} contactHref={nav.contactHref} autoMotion={false} />
</InternalPageLayout>
