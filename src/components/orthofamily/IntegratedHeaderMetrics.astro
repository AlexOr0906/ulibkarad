<script>
  const bar = document.querySelector<HTMLElement>('.of-complete .hn-bar');
  if (bar) {
    let previous = 0;
    const sync = () => {
      const height = Math.ceil(bar.getBoundingClientRect().height + 1);
      if (height === previous) return;
      previous = height;
      document.documentElement.style.setProperty('--of-header-height', `${height}px`);
      document.documentElement.style.setProperty('--site-header-height', `${height}px`);
      dispatchEvent(new Event('of-header-resize'));
    };
    new ResizeObserver(sync).observe(bar);
    document.fonts.ready.then(sync);
    sync();
  }
</script>
