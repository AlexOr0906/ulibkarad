---
import ArrowIcon from '../ArrowIcon.astro';
import { addressSearchLink, contactDetails, type ClinicContacts } from '../../data/contacts-footer';
import '../../styles/contacts-footer.css';
interface Props { contacts?: ClinicContacts; }
const { contacts = contactDetails } = Astro.props;
const mapLink = addressSearchLink(contacts.city, contacts.address);
const showClinicScheme = contacts.city === contactDetails.city && contacts.address === contactDetails.address;
---
<section class="cf-contacts" id="contacts" aria-labelledby="cf-contacts-title">
  <div class="cf-wrap">
    <div class="cf-section-intro"><p>Контакты</p><p>{contacts.city}</p></div>
    <div class="cf-heading-row">
      <h2 id="cf-contacts-title">Будем ближе.</h2>
      <p>Знакомство с OrthoFamily<br />начинается с разговора.</p>
    </div>
    <div class="cf-contact-grid">
      <div class="cf-contact-copy">
        <dl class="cf-details">
          <div class="cf-address"><dt>Адрес клиники</dt><dd data-cf-contact="address">{contacts.address ?? 'Точный адрес скоро появится'}{contacts.entrance && <><br />{contacts.entrance}</>}</dd></div>
          <div><dt>Телефон</dt><dd data-cf-contact="phone">{contacts.phone?.href ? <a href={contacts.phone.href}>{contacts.phone.label}</a> : contacts.phone?.label ?? 'Номер будет добавлен'}</dd></div>
          <div><dt>Режим работы</dt><dd data-cf-contact="hours">{contacts.hours ?? 'Расписание уточняется'}</dd></div>
          <div><dt>Электронная почта</dt><dd data-cf-contact="email">{contacts.email ? <a href={`mailto:${contacts.email}`}>{contacts.email}</a> : 'Адрес будет добавлен'}</dd></div>
        </dl>
        {(contacts.phone?.href||contacts.email)&&<details class="cf-visit">
          <summary>Обсудить визит <ArrowIcon /></summary>
          <div class="cf-visit-note"><p>Чтобы обсудить визит, воспользуйтесь контактами выше.</p></div>
        </details>}

      </div>
      <div class="cf-map-area">
        <slot name="map">
          <div class="cf-map-frame">
            <div class="cf-map-fallback">
              {showClinicScheme ? (
                <figure class="cf-map-scheme">
                  <img src={`${import.meta.env.BASE_URL}orthofamily/clinic-location-scheme.svg`} width="480" height="270" alt="Дом 23 на улице Калинина напротив Университетского сквера. Вход со стороны сквера." />
                  <figcaption>Схема расположения · без масштаба</figcaption>
                </figure>
              ) : (
                <>
                  <p>{contacts.city}{contacts.address ? `, ${contacts.address}` : ''}</p>
                  {contacts.entrance && <p>{contacts.entrance}</p>}
                </>
              )}
              <a href={mapLink} target="_blank" rel="noopener noreferrer">Открыть Яндекс Карты <ArrowIcon /></a>
            </div>
            <iframe class="cf-city-map" title={`Яндекс Карты: ${contacts.city}${contacts.address ? `, ${contacts.address}` : ''}`} src={addressSearchLink(contacts.city, contacts.address, true)} width="640" height="420"></iframe>
          </div>
        </slot>
        <p class="cf-map-caption"><a href={mapLink} target="_blank" rel="noopener noreferrer">Открыть адрес в Яндекс Картах</a></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initClosingMotion } from './closing-motion';
  initClosingMotion();
</script>
